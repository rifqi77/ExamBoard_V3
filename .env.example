# =============================================================================
# Exam Dashboard — environment template.
# Copy to `.env` and fill in. NEVER commit a real `.env` file.
# After cloning: `cp .env.example .env && php artisan key:generate`
# =============================================================================

APP_NAME="Exam Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://exam.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# bcrypt cost. 12 is the standard for production; lower (e.g. 10) only on
# very small servers if login latency is a problem.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =============================================================================
# Database (MySQL 8 / MariaDB 10.5+)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exam_dashboard
DB_USERNAME=
DB_PASSWORD=

# =============================================================================
# Session / cache / queue
# =============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# Mail (defaults to log — fine for an exam app without email features)
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# EXAM PLATFORM SECRETS — MUST be regenerated for each deployment
# =============================================================================
#
# Dual-purpose: HS256 JWT signing key AND root of every at-rest encryption key
# (AES-256-GCM, domain-tagged for AI provider keys, student plaintext
# passwords, and exam-access token previews).
#
# CRITICAL: rotating this invalidates ALL existing sessions AND makes every
# encrypted column unreadable. Generate ONCE before first deploy and back it
# up securely. >= 32 chars, alphanumeric.
#
# Generate with: openssl rand -hex 32
#                or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Long-lived session cookie name + TTL (days, clamped 1..30).
SESSION_COOKIE_NAME=secure-exam-session
SESSION_COOKIE_DAYS=5

# Per-IP rate limit on the login endpoint (default 1000 / minute). Lower
# on small servers or behind a known-good IP range.
LOGIN_IP_RATE_LIMIT=1000

# =============================================================================
# AI providers (server-only)
# Leave blank → falls back to the keyless Pollinations provider (free + works
# out of the box, lower quality). Fill in for production-grade output.
# =============================================================================
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Vite (build-time)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
