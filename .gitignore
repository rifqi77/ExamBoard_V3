# ---- Secrets & local config (CRITICAL — never commit these) -----------------
.env
.env.*
!.env.example
.env.backup
.env.production
.env.staging
.env.local
auth.json
*.pem
*.key
storage/*.key

# ---- Dependencies (rebuilt by composer install / npm ci) -------------------
/node_modules
/vendor

# ---- Build artifacts (regenerated by vite) ---------------------------------
/public/build
/public/hot
/public/storage

# ---- Logs / cache (runtime, leaks request data) ----------------------------
*.log
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/pail
/bootstrap/cache/*.php
.phpunit.result.cache
/.phpunit.cache

# ---- Load-test outputs (test data, not source) -----------------------------
/loadtest/results.json
/loadtest/*.log

# ---- Local debug / verification scratch files ------------------------------
*.bak
parse_*.php
debug_*.php
verify_*.php
check_*.php
cjs*.txt
*_cookies.txt
curriculum_dbg.xlsx
exam.html
score.html
answers.json

# ---- IDE / editor / OS state ----------------------------------------------
/.claude
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.phpactor.json
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml

# ---- Backups -----------------------------------------------------------------
*.sql
*.sql.gz
backups/
